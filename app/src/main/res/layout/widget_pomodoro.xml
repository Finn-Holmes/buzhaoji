<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_pomodoro_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_pomodoro_background" />

    <LinearLayout
        android:id="@+id/widget_pomodoro_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <Chronometer
            android:id="@+id/widget_pomodoro_time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/widget_pomodoro_default_time"
            android:textColor="#FFFF5C65"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_pomodoro_toggle"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_pomodoro_play"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/widget_pomodoro_settings"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_more"
            android:textColor="#FFB8B8BE"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
