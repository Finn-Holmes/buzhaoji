<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_preview_expectation_surface">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="3dp" android:maxLines="1" android:ellipsize="end"
        android:text="日子里的期待" android:textColor="#3E3649" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="3dp" android:maxLines="1" android:ellipsize="end"
        android:text="✦  下一次旅行                 还有 7 天" android:textColor="#3E3649" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="3dp" android:maxLines="1" android:ellipsize="end"
        android:text="✦  生日                            还有 35 天" android:textColor="#3E3649" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
