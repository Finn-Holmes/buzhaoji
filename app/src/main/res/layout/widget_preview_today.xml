<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_preview_light_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="3dp" android:maxLines="1" android:ellipsize="end"
        android:text="今天，慢慢来" android:textColor="#3E3649" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="3dp" android:maxLines="1" android:ellipsize="end"
        android:text="○  整理今天的课堂笔记" android:textColor="#3E3649" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="3dp" android:maxLines="1" android:ellipsize="end"
        android:text="○  留一点时间给自己" android:textColor="#3E3649" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
